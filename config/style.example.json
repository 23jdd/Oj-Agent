{
  "version": 1,
  "fonts": {
    "ui_family": "Microsoft YaHei UI",
    "code_family": "Consolas",
    "animation_family": "Microsoft YaHei UI",
    "text_size": 14,
    "label_size": 13,
    "heading_size": 24,
    "animation_scale": 1,
    "minimum_text_pixels": 13,
    "line_height": 1.45
  },
  "colors": {
    "background": "#f5f5f5",
    "surface": "#ffffff",
    "surface_hover": "#fae583",
    "surface_active": "#ffcc00",
    "border": "#000000",
    "text_primary": "#000000",
    "text_secondary": "#5a5a5a",
    "text_disabled": "#737373",
    "disabled": "#e5e5e5",
    "accent": "#ffdb33",
    "focus": "#5f4fe6",
