import { MessageView, ChatMessage, AttachmentItem, MarkdownBlock } from "chat.slint";
export { ChatMessage, AttachmentItem, MarkdownBlock } from "chat.slint";
import { AnimationPage } from "animation-page.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
import { StyleEditor, StyleField } from "style-editor.slint";
export { StyleField } from "style-editor.slint";
import { AppButton, IconButton, TextField, TextArea, SelectBox, AppCheckBox, SeekBar, SectionLabel, Divider, Panel } from "components.slint";

export struct SessionItem { id: string, title: string, status: string }

export component AppWindow inherits Window {
    title: "OJ Agent · 算法演绎";
    icon: @image-url("icons/app-icon.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : Theme.spacing-sm;
    preferred-width: 1320px; preferred-height: 860px;
    min-width: 960px; min-height: 640px;
    background: Theme.background;
    default-font-family: Theme.font-family;
    default-font-size: Theme.text-size;
    in-out property <int> provider-index: 0;
    in-out property <string> model-name: "gpt-4.1-mini";
    in-out property <string> endpoint;
    in-out property <string> api-key;
    in-out property <bool> settings-open: false;
    in-out property <bool> style-open: false;
    in property <[StyleField]> style-fields;
    in property <string> style-error;
    in property <string> style-path;
    in property <string> model-config-path;
    in-out property <string> settings-error;
    callback open-style;
    callback edit-style(int, string);
    callback save-style;
    callback reset-style;
    private property <bool> history-open: true;
    private property <bool> source-open: false;
    in property <bool> busy: false;
    in property <bool> playing: false;
    in property <string> selected-session;
    in property <[SessionItem]> sessions;
    in-out property <string> composer;
    in property <[ChatMessage]> messages;
    in property <[AttachmentItem]> attachments;
    in-out property <bool> animation-open: false;
    in property <string> animation-title;
    in property <string> animation-basis;
    in property <[string]> case-names;
    in-out property <int> case-index;
    callback send-message;
    callback attach-files;
    callback composer-edited;
    callback remove-attachment(string);
    callback open-link(string);
    callback select-case(int);
    callback back-to-chat;
    private property <bool> reveal-pending: false;
    public function reveal-latest() { root.reveal-pending = true; }
    in property <image> frame;
    in property <int> frame-pixel-width: 0;
    in property <int> frame-pixel-height: 0;
    in property <float> preview-scale-factor: 1;
    out property <length> preview-width: animation-page.preview-width;
    out property <length> preview-height: animation-page.preview-height;
    in property <string> status-text: "就绪";
    in property <string> time-label: "0.0 / 0.0 s";
    in property <string> error-text;
    in-out property <float> position: 0;
    in-out property <int> speed-index: 1;
    in-out property <string> export-path: "animation.gif";
    callback cancel;
    callback new-session;
    callback select-session(string);
    callback delete-session;
    callback save-model;
    callback play-pause;
    callback step(bool);
    callback restart;
    callback seek(float);
    callback change-speed(int);
    callback export-gif;
    callback export-json;

    VerticalLayout {
        padding: Theme.spacing-lg; spacing: Theme.spacing-md;
        HorizontalLayout {
            height: Theme.titlebar-height; spacing: Theme.spacing-lg;
            WindowMoveArea {
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: Theme.spacing-lg;
                    Rectangle {
                        width: 44px; height: 40px; background: Theme.border;
                        Rectangle {
                            width: 40px; height: 36px; background: Theme.accent;
                            border-width: Theme.border-width; border-color: Theme.border;
                            Text { text: "OJ"; font-weight: 800; color: Theme.text-primary; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    Text { text: "OJ AGENT"; font-weight: 800; color: Theme.text-primary; font-size: Theme.heading-size; vertical-alignment: center; }

                }
                TouchArea { double-clicked => { root.maximized = !root.maximized; } }
            }
            AppButton { text: "会话"; width: 80px; horizontal-stretch: 0; selected: root.history-open; clicked => { root.history-open = !root.history-open; } }
            AppButton { text: "外观"; width: 80px; horizontal-stretch: 0; enabled: !root.busy; clicked => { root.settings-open = false; root.open-style(); } }
            AppButton { text: "模型设置"; width: 128px; horizontal-stretch: 0; clicked => { root.style-open = false; root.settings-error = ""; root.settings-open = true; } }
            HorizontalLayout {
                spacing: Theme.spacing-xs;
                IconButton { text: "最小化"; icon: @image-url("icons/window-minimize.svg"); clicked => { root.minimized = true; } }
                IconButton { text: root.maximized ? "还原窗口" : "最大化"; icon: root.maximized ? @image-url("icons/window-restore.svg") : @image-url("icons/window-maximize.svg"); clicked => { root.maximized = !root.maximized; } }
                IconButton { text: "关闭窗口"; icon: @image-url("icons/window-close.svg"); destructive: true; clicked => { root.close(); } }
            }
        }
        HorizontalLayout {
            spacing: Theme.spacing-md; vertical-stretch: 1;
            if root.history-open: Panel {
                width: Theme.sidebar-width;
                VerticalLayout {
                    padding: Theme.spacing-md; spacing: Theme.spacing-sm;
                    SectionLabel { text: "对话 / CONVERSATIONS"; font-weight: 700; color: Theme.text-primary; }
                    AppButton { text: "+ 新对话"; primary: true; enabled: !root.busy; clicked => { root.new-session(); } }
                    Divider {}
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            spacing: Theme.spacing-sm;
                            for item in root.sessions: AppButton {
                                text: item.title;
                                text-align: start;
                                selected: item.id == root.selected-session;
                                enabled: !root.busy;
                                clicked => { root.select-session(item.id); }
                            }
                        }
                    }
                    AppButton { text: "删除对话"; enabled: root.selected-session != "" && !root.busy; clicked => { root.delete-session(); } }
                }
            }
            // Keep the chat instantiated while the animation page is open so its scroll
            // area and composer keep their sizes when returning.
            Rectangle {
                visible: !root.animation-open;
                vertical-stretch: 1;
                min-height: 0px;
                min-width: 0px;
                max-width: root.animation-open ? 0px : 100000px;
                horizontal-stretch: root.animation-open ? 0 : 1;
                clip: true;
                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    min-height: 0px;
                    Timer {
                    interval: 16ms;
                    running: root.reveal-pending && !root.animation-open;
                    triggered => {
                        message-scroll.content-y = min(0px, message-scroll.visible-height - message-scroll.content-height);
                        root.reveal-pending = false;
                    }
                }
                spacing: Theme.spacing-md;
                message-scroll := ScrollView {
                    min-height: 0px; preferred-height: 0px; vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        padding: Theme.spacing-lg; spacing: Theme.spacing-md;
                        if root.messages.length == 0: VerticalLayout {
                            spacing: Theme.spacing-lg;
                            Text { text: "从一个问题开始。"; font-size: Theme.heading-size; font-weight: 700; color: Theme.text-primary; }
                            Text { text: "讨论题目、检查代码，或让 AI 解释执行过程。输入 @ 添加文件。\n需要动画时，AI 会在消息中提供可打开的动画入口。"; font-size: Theme.text-size; color: Theme.text-secondary; wrap: word-wrap; }
                        }
                        for message in root.messages: MessageView { message: message; open-link(url) => { root.open-link(url); } }
                    }
                }
                if root.attachments.length > 0: HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    for file in root.attachments: AppButton { text: "@" + file.name + " ×"; enabled: !root.busy; clicked => { root.remove-attachment(file.id); } }
                }
                Panel {
                    vertical-stretch: 0;
                    VerticalLayout {
                        padding: Theme.spacing-sm; spacing: Theme.spacing-sm;
                        TextArea { text <=> root.composer; enabled: !root.busy; height: 112px; edited(value) => { root.composer-edited(); } submitted => { if !root.busy { root.send-message(); } } }
                        HorizontalLayout {
                            spacing: Theme.spacing-sm;
                            AppButton { text: "@ 添加文件"; width: 128px; horizontal-stretch: 0; enabled: !root.busy; clicked => { root.attach-files(); } }
                            SectionLabel { text: "Markdown · Ctrl+Enter 发送"; horizontal-stretch: 1; }
                            if root.busy: AppButton { text: "停止"; width: 80px; horizontal-stretch: 0; clicked => { root.cancel(); } }
                            AppButton { text: "发送 ↑"; width: 96px; horizontal-stretch: 0; primary: true; enabled: !root.busy && (root.composer != "" || root.attachments.length > 0); clicked => { root.send-message(); } }
                        }
                    }
                }
                }
            }
            animation-page := AnimationPage {
                visible: root.animation-open;
                min-width: 0px;
                max-width: root.animation-open ? 100000px : 0px;
                horizontal-stretch: root.animation-open ? 1 : 0;
                frame: root.frame; frame-pixel-width: root.frame-pixel-width; frame-pixel-height: root.frame-pixel-height;
                preview-scale-factor: root.preview-scale-factor;
                title: root.animation-title; basis: root.animation-basis;
                case-names: root.case-names; case-index <=> root.case-index;
                busy: root.busy; playing: root.playing; time-label: root.time-label;
                position <=> root.position; speed-index <=> root.speed-index; export-path <=> root.export-path;
                back => { root.back-to-chat(); }
                select-case(index) => { root.select-case(index); }
                play-pause => { root.play-pause(); } step(forward) => { root.step(forward); }
                restart => { root.restart(); } seek(value) => { root.seek(value); }
                change-speed(index) => { root.change-speed(index); }
                export-gif => { root.export-gif(); } export-json => { root.export-json(); }
            }
        }
        if root.error-text != "": Panel {
            max-height: 64px; min-height: 40px;
            VerticalLayout {
                padding: Theme.spacing-sm;
                ScrollView { Text { text: root.error-text; color: Theme.danger; font-size: Theme.label-size; wrap: word-wrap; } }
            }
        }
        HorizontalLayout {
            height: 20px; spacing: Theme.spacing-sm;
            SectionLabel { text: root.busy ? "●  " + root.status-text : "■  " + root.status-text; horizontal-stretch: 1; }
        }
    }
    if root.style-open: Rectangle {
        y: 2 * Theme.spacing-lg + Theme.titlebar-height;
        height: root.height - self.y;
        background: Theme.background;
        TouchArea {}
        Panel {
            x: (parent.width - self.width) / 2; y: Theme.spacing-md;
            width: min(760px, parent.width - 2 * Theme.spacing-xl);
            height: parent.height - 2 * Theme.spacing-md;
            StyleEditor {
                fields: root.style-fields; error: root.style-error; config-path: root.style-path;
                edited(index, value) => { root.edit-style(index, value); }
                save => { root.save-style(); }
                reset => { root.reset-style(); }
                cancel => { root.style-open = false; }
            }
        }
    }
    if root.settings-open: Rectangle {
        y: 2 * Theme.spacing-lg + Theme.titlebar-height;
        height: root.height - self.y;
        background: Theme.background;
        TouchArea {}
        Panel {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 640px; height: 520px;
            VerticalLayout {
                padding: Theme.spacing-xl; spacing: Theme.spacing-md;
                Text { text: "模型设置 / MODEL"; color: Theme.text-primary; font-size: Theme.heading-size; font-weight: 700; }
                SectionLabel { text: "配置保存在本机；API Key 只写入本机配置文件，不写入会话。"; }
                HorizontalLayout {
                    spacing: Theme.spacing-md;
                    SelectBox { model: ["OpenAI", "DeepSeek", "兼容接口"]; current-index <=> root.provider-index; enabled: !root.busy; }
                    TextField { text <=> root.model-name; placeholder-text: "Model ID"; enabled: !root.busy; }
                }
                SectionLabel { text: "API KEY"; }
                TextField { text <=> root.api-key; input-type: password; placeholder-text: "输入服务商的 API Key"; enabled: !root.busy; }
                SectionLabel { text: "接口地址 / ENDPOINT"; }
                TextField { text <=> root.endpoint; placeholder-text: "留空使用默认地址；兼容接口填写 /v1 地址"; enabled: !root.busy; }
                SectionLabel { text: "对话使用所选模型；动画与代码检查由 AI 按需调用。"; }
                if root.settings-error != "": Text { text: root.settings-error; color: Theme.danger; font-size: Theme.label-size; wrap: word-wrap; max-height: 48px; }
                Text { text: "配置文件：" + root.model-config-path; color: Theme.text-secondary; font-size: Theme.label-size; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: Theme.spacing-sm;
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { text: "取消"; width: 104px; horizontal-stretch: 0; clicked => { root.settings-error = ""; root.settings-open = false; } }
                    AppButton { text: "保存"; width: 104px; horizontal-stretch: 0; primary: true; clicked => { root.save-model(); } }
                }
            }
        }
    }
}
