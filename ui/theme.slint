export struct ThemeColor { value: string, tint: color }
export global Theme {
    out property <[ThemeColor]> color-choices: [
        {value: "#ffdb33", tint: #ffdb33}, {value: "#8be5bd", tint: #8be5bd},
        {value: "#c4b5fd", tint: #c4b5fd}, {value: "#93c5fd", tint: #93c5fd},
        {value: "#fda4af", tint: #fda4af}, {value: "#ffffff", tint: #ffffff},
        {value: "#f5f5f5", tint: #f5f5f5}, {value: "#5a5a5a", tint: #5a5a5a},
        {value: "#000000", tint: #000000}, {value: "#28723d", tint: #28723d}
    ];
    in-out property <string> code-font-family: "Consolas";
    in-out property <string> font-family: "Microsoft YaHei UI";
    in-out property <color> background: #f5f5f5;
    in-out property <color> surface: #ffffff;
    in-out property <color> surface-hover: #fae583;
    in-out property <color> surface-active: #ffcc00;
    in-out property <color> border: #000000;
    out property <color> border-strong: Theme.border;
    in-out property <color> text-primary: #000000;
    in-out property <color> text-secondary: #5a5a5a;
    in-out property <color> text-disabled: #737373;
    in-out property <color> disabled: #e5e5e5;
    in-out property <color> accent: #ffdb33;
    out property <color> accent-hover: Theme.surface-active;
    in-out property <color> focus: #5f4fe6;
    in-out property <color> success: #28723d;
    in-out property <color> danger: #a91f2d;
    in-out property <length> spacing-xs: 4px;
    in-out property <length> spacing-sm: 8px;
    in-out property <length> spacing-md: 12px;
    in-out property <length> spacing-lg: 16px;
    in-out property <length> spacing-xl: 24px;
    in-out property <length> radius-sm: 0px;
    in-out property <length> border-width: 2px;
    in-out property <length> shadow-offset: 4px;
    in-out property <length> control-height: 36px;
    in-out property <length> titlebar-height: 48px;
    in-out property <length> text-size: 14px;
    in-out property <length> label-size: 13px;
    in-out property <length> heading-size: 24px;
    in-out property <length> sidebar-width: 168px;
    in-out property <length> form-width: 280px;
}
