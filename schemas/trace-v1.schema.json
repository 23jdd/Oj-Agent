  "title": "TraceIr",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TraceEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "seq": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "entity": {
          "type": "string"
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "explanation": {
          "type": "string"
        },
        "state": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "entity",
        "indices",
        "values",
        "explanation",
        "state"
      ]
    },
    "EventKind": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "compare",
        "insert",
        "remove",
        "swap",
        "push",
        "pop",
        "enqueue",
        "dequeue",
        "visit",
        "branch",
        "return"
      ]
    }
  }
