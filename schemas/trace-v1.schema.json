    },
    "id": {
      "type": "string"
    },
    "algorithm": {
      "type": "string"
    },
    "trace_source": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "initial_state": {
      "type": "object",
      "additionalProperties": true
    },
    "events": {
