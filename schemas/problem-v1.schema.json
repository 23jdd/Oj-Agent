{
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "algorithm": {
      "$ref": "#/$defs/Algorithm"
    },
    "values": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64"
      }
    },
    "target": {
      "type": "integer",
      "format": "int64"
    },
    "source_code": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "default": "python"
    },
    "stdin": {
      "type": "string",
      "default": ""
    },
    "execute_source": {
      "type": "boolean",
      "default": false
    },
    "graph": {
      "anyOf": [
        {
          "$ref": "#/$defs/GraphInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "title",
    "description",
    "algorithm",
    "values",
    "target"
  ],
  "title": "ProblemInput",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Algorithm": {
      "type": "string",
      "enum": [
        "array-traversal",
        "two-sum",
        "binary-search",
        "bubble-sort",
        "two-pointers",
        "sliding-window",
        "stack",
        "queue",
        "bfs",
        "dfs",
        "fibonacci"
      ]
    },
    "GraphInput": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "directed": {
          "type": "boolean",
          "default": false
        },
        "start": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "edges"
      ]
    }
  }
}