{
  "type": "object",
  "properties": {
    "schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "type": "string"
    },
    "scene": {
      "$ref": "#/$defs/Scene"
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AnimationAction"
      }
    },
    "duration": {
      "type": "number",
      "format": "double"
    },
    "step_times": {
      "type": "array",
      "items": {
        "type": "number",
        "format": "double"
      }
    }
  },
  "required": [
    "schema",
    "version",
    "id",
    "scene",
    "timeline",
    "duration",
    "step_times"
  ],
  "title": "AnimationIr",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Scene": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SceneObject"
          }
        }
      },
      "required": [
        "width",
        "height",
        "objects"
      ]
    },
    "SceneObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "x": {
          "type": "number",
          "format": "float"
        },
        "y": {
          "type": "number",
          "format": "float"
        },
        "width": {
          "type": "number",
          "format": "float"
        },
        "height": {
          "type": "number",
          "format": "float"
        },
        "text": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "state": {
          "type": "string"
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        },
        "directed": {
          "type": "boolean",
          "default": false
        },
        "edge_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        },
        "pointers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenePointer"
          },
          "default": []
        },
        "parents": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint",
            "minimum": 0
          },
          "default": []
        },
        "rows": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "cols": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height",
        "text",
        "values",
        "state"
      ]
    },
    "ScenePointer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "target": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "name",
        "target"
      ]
    },
    "AnimationAction": {
      "type": "object",
      "properties": {
        "at": {
          "type": "number",
          "format": "double"
        },
        "duration": {
          "type": "number",
          "format": "double"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "target": {
          "type": "string"
        },
        "indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          }
        },
        "text": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          }
        },
        "structure": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneStructure"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "at",
        "duration",
        "action",
        "target",
        "indices",
        "text",
        "values"
      ]
    },
    "Action": {
      "type": "string",
      "enum": [
        "highlight",
        "update-text",
        "update-value",
        "show",
        "hide",
        "wait"
      ]
    },
    "SceneStructure": {
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        },
        "edge_labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "float"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "default": []
        },
        "pointers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenePointer"
          },
          "default": []
        },
        "parents": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint",
            "minimum": 0
          },
          "default": []
        }
      },
      "description": "Structural state that can change independently of numeric cell values."
    }
  }
}